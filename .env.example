# Required build/push tag and Runpod credentials.
# For approved releases, set BASE_IMAGE to the official Paddle tag pinned by digest.
BASE_IMAGE=
DOCKER_IMAGE=ghcr.io/YOUR_ORG/runpod-paddleocr-vl:3.0.0
RUNPOD_API_KEY=

# Optional deployment reference. Prefer an immutable digest after pushing.
# Falls back to DOCKER_IMAGE when empty.
RUNPOD_IMAGE=

# Required: exact HTTPS hostnames from which the worker may fetch signed PDFs.
ALLOWED_SOURCE_HOSTS=your-worker.example.workers.dev

# Resource names.
RUNPOD_TEMPLATE_NAME=paddleocr-vl-1-6-serverless
RUNPOD_ENDPOINT_NAME=paddleocr-vl-1-6
RUNPOD_CONTAINER_REGISTRY_AUTH_ID=

# REST API v2 endpoint configuration.
# AMPERE_24 includes L4, A5000, and RTX 3090; ADA_24 includes RTX 4090.
RUNPOD_GPU_POOLS=AMPERE_24,ADA_24
RUNPOD_DATA_CENTER_IDS=
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_WORKERS_MIN=0
RUNPOD_WORKERS_MAX=2
RUNPOD_IDLE_TIMEOUT_SECONDS=60
RUNPOD_EXECUTION_TIMEOUT_MS=1800000
RUNPOD_SCALER_TYPE=QUEUE_DELAY
RUNPOD_SCALER_VALUE=4
RUNPOD_FLASHBOOT=OFF
RUNPOD_ROLLOUT_TIMEOUT_SECONDS=600

# Fixed worker policy. Callers cannot override these values.
PADDLE_DEVICE=gpu:0
PADDLE_ENGINE=paddle
MAX_INPUT_BYTES=52428800
MAX_PDF_PAGES=25
MAX_PDF_PAGE_EDGE_POINTS=3600
MAX_PDF_PAGE_AREA_POINTS=10000000
MAX_OUTPUT_BYTES=8388608
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_REDIRECTS=0
USE_DOC_ORIENTATION_CLASSIFY=false
USE_DOC_UNWARPING=false
USE_LAYOUT_DETECTION=true
USE_CHART_RECOGNITION=false
USE_SEAL_RECOGNITION=false
TEMPERATURE=0
MAX_NEW_TOKENS=8192
LOG_LEVEL=INFO
RUNPOD_LOG_LEVEL=ERROR

# Added by deploy.py after deployment, or set manually.
RUNPOD_ENDPOINT_ID=

# Required only for the live smoke test.
TEST_FILE_URL=
SMOKE_TIMEOUT_SECONDS=1800
SMOKE_EXECUTION_TIMEOUT_MS=1800000
SMOKE_TTL_MS=7200000
